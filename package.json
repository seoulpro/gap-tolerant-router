{
  "name": "gap-tolerant-router",
  "version": "0.1.1",
  "description": "A deterministic router for imperfect planar line networks.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./engine": {
      "types": "./src/engine.d.ts",
      "import": "./src/engine.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "coverage": "node --experimental-test-coverage --test --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95",
    "lint": "node --check src/index.js && node --check src/router.js && node --check src/instructions.js && node --check src/numerics.js && node --check src/engine.js && node --check examples/run-industrial-conformance.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "package:lint": "publint",
    "package:types": "node scripts/check-package-types.mjs",
    "package:check": "node scripts/check-package.mjs",
    "examples:industrial": "node examples/run-industrial-conformance.mjs",
    "check": "npm run lint && npm run typecheck && npm run coverage && npm run package:lint && npm run package:types && npm run package:check",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "routing",
    "graph",
    "a-star",
    "pathfinding",
    "planar-graph",
    "topology"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "seoulpro <lim@limsumin.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoulpro/gap-tolerant-router.git"
  },
  "bugs": {
    "url": "https://github.com/seoulpro/gap-tolerant-router/issues"
  },
  "homepage": "https://github.com/seoulpro/gap-tolerant-router#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.22",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
